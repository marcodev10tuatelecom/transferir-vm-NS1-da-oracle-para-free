# Copie para /root/tps-rebuild/common.env fora do Git.
TPS_DOMAIN=tpsolutions.com.br
MEDIA_DOMAIN=studiosatweb.com.br
NS1_FQDN=ns1.tpsolutions.com.br
NS2_FQDN=ns2.tpsolutions.com.br
ACME_EMAIL=CHANGE_ME
MEDIAMTX_VERSION=v1.20.1
# SHA-256 do tarball oficial exatamente correspondente a VERSION+ARCH.
MEDIAMTX_SHA256=CHANGE_ME
DNSSEC_TPS=no
DNSSEC_MEDIA=yes
ENABLE_SRT=no
ENABLE_IPV6=no
PRIMARY_ZONES="tpsolutions.com.br studiosatweb.com.br"
DNSSEC_ZONES="studiosatweb.com.br"
ZONE_SOURCE_DIR=/root/tps-rebuild/zones
# Edite para refletir somente FQDNs realmente publicados no novo edge.
MEDIA_TLS_HOSTS="radio.studiosatweb.com.br pop.radio.studiosatweb.com.br rock.radio.studiosatweb.com.br classicas.radio.studiosatweb.com.br country.radio.studiosatweb.com.br radiotv.studiosatweb.com.br tvkidsweb.studiosatweb.com.br tvteensweb.studiosatweb.com.br tvvivaweb.studiosatweb.com.br tvmaisjovemweb.studiosatweb.com.br"
STATIONS="radio-main radio-pop radio-rock radio-classicas radio-country tvkids-main tvteens-main tvviva-main tvmaisjovem-main"
DERIVED_PATHS="tv-main"
